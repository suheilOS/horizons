{
	"$schema": "https://unpkg.com/wrangler@4.110.0/config-schema.json",
	"name": "horizons",
	"main": "./worker/index.ts",
	"routes": [
		{
			"pattern": "horizons.overhawl.app",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-08-23",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/health"
		]
	},
	"services": [
		{
			"binding": "AUTH_SERVICE",
			"service": "overhawl-auth",
			"entrypoint": "AuthService",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "HORIZONS_DB",
			"database_name": "horizons",
			"database_id": "0ef0472e-d00b-4e87-af67-98fbb9450d71",
			"migrations_dir": "./migrations"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		}
	}
}