{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:cloudflare": "bun run build && wrangler dev",
    "preview:local": "VITE_AUTH_ORIGIN=http://localhost:8788 bun run build && wrangler dev --config wrangler.local.jsonc --port 8787",
    "migrate:local": "wrangler d1 migrations apply horizons --config wrangler.local.jsonc --local",
    "test": "vitest run --config vitest.config.ts",
    "types": "wrangler types",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/open-runde": "^5.2.1",
    "hono": "^4.13.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^9.30.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.0",
    "wrangler": "4.125.0"
  }
}
